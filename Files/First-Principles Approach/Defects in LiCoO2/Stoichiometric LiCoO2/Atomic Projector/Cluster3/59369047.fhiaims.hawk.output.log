  #     hydro 6 h 14.4
  #  "Fourth tier" (minor improvements)
  #     hydro 5 f 16
  #     hydro 5 d 8
  #     hydro 4 p 10
  #     hydro 5 s 7.4
  
  plus_u 3 d 4.074
  hubbard_coefficient 1 0 0 0
  
