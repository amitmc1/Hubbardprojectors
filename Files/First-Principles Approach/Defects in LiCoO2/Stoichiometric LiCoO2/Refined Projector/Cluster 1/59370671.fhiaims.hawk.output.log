  #     hydro 2 p 5.8
  #     hydro 4 f 8
  #     hydro 5 g 11.6
  #     hydro 4 s 4.3
  #     hydro 6 h 14.4
  #  "Fourth tier" (minor improvements)
  #     hydro 5 f 16
  #     hydro 5 d 8
  #     hydro 4 p 10
  #     hydro 5 s 7.4
  
  plus_u 3 d 4.731
  hubbard_coefficient 0.834 -0.470 0 0
  
