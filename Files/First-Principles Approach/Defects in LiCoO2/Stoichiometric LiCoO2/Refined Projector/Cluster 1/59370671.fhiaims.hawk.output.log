  ################################################################################
  #  "First tier" (improvements: -167.79 meV ...  -15.31 meV)
       hydro 3 p 5.8
       hydro 4 f 8.2
       hydro 3 d 5.4
  #     hydro 5 g 12
       ionic 4 s auto
  #  "Second tier" (improvements: -8.83 meV ... -0.89 meV)
       ionic 4 p auto
