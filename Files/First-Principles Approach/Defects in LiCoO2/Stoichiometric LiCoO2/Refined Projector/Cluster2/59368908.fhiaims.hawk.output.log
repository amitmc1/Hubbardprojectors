  xc                                 libxc MGGA_X_MBEEF+GGA_C_PBE_SOL
  k_grid                             15 15 3
  occupation_type                    gaussian 0.1
  plus_u_petukhov_mixing             1
  plus_u_matrix_control              True
  plus_u_use_hydros                  True
  sc_accuracy_etot                   1e-06
  sc_accuracy_eev                    0.001
