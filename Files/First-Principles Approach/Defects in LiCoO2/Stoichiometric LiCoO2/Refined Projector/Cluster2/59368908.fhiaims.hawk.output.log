      ion_occ      3  d   6.
  ################################################################################
  #
  #  Suggested additional basis functions. For production calculations,
  #  uncomment them one after another (the most important basis functions are
  #  listed first).
  #
  #  Constructed for dimers: 1.8, 2.0, 2.5, 3.5 Ang
  #
  ################################################################################
  #  "First tier" (improvements: -167.79 meV ...  -15.31 meV)
       hydro 3 p 5.8
       hydro 4 f 8.2
       hydro 3 d 5.4
  #     hydro 5 g 12
       ionic 4 s auto
  #  "Second tier" (improvements: -8.83 meV ... -0.89 meV)
       ionic 4 p auto
  #     hydro 6 h 16.4
  #     hydro 4 d 5.6
  #     hydro 4 f 17.2
  #     hydro 1 s 0.75
  #  "Third tier" (improvements: -1.03 meV ... -0.06 meV)
  #     hydro 4 d 7.8
  #     hydro 2 p 5.8
  #     hydro 4 f 8
  #     hydro 5 g 11.6
  #     hydro 4 s 4.3
  #     hydro 6 h 14.4
  #  "Fourth tier" (minor improvements)
  #     hydro 5 f 16
  #     hydro 5 d 8
  #     hydro 4 p 10
  #     hydro 5 s 7.4
  
  plus_u 3 d 3.342
  hubbard_coefficient 0.792 -0.506 0 0
  
